PORT=3000
SITE_NAME=NovaLink
SITE_URL=http://localhost:3000
# Long random string. REQUIRED in production.
JWT_SECRET=change-me-to-a-long-random-string
CURRENCY=NGN
CURRENCY_SYMBOL=?
# First admin account (created on first start)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisNow123
# Paystack (https://dashboard.paystack.com). Leave empty to use manual/offline funding only.
PAYSTACK_SECRET=
# Optional SMM panel API (standard "action=add" API) for automatic boosting fulfilment
SMM_API_URL=
SMM_API_KEY=
# Bank details shown for manual funding (admin credits wallet after confirming)
MANUAL_PAYMENT_INFO=Bank: Your Bank | Acct: 0000000000 | Name: Your Business
